<xml xmlns="http://www.w3.org/1999/xhtml">
<block id="G?$ph-S,gTHMLNrYM(;?" type="device_button_event">
<field name="NAME">Button.A</field>
<statement name="HANDLER">
<block id="h7R?;.BH/aeG^|OW.=D=" type="device_show_number">
<value name="number">
<block type="stelr_ev_joystick">
<field name="axis">stelrEV.JoystickAxis.X</field>
</block>
</value>
</block>
</statement>
<comment pinned="false">GamePad only&#58; A shows X&#44; B shows Y. C activates feedback while held.</comment>
</block>
<block id="scv*OS#-E5/o#*PWV7N9" type="device_button_event">
