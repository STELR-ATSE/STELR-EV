<block type="stelr_ev_joystick">
<field name="axis">stelrEV.JoystickAxis.Y</field>
</block>
</value>
</block>
</statement>
</block>
<block id="MaB]Y[#=%4ymfKiSaUnK" type="stelr_ev_button_event">
